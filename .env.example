# Copy values into your shell environment before starting the server.

# Optional: Netscape cookies.txt for platforms that require login.
# A Bilibili account with 4K / premium access is required to receive 4K formats.
# YTDLP_COOKIES=./cookies.txt

# Optional: proxy for platforms blocked by the current network.
# YTDLP_PROXY=http://127.0.0.1:7890

# Optional: where downloads and AI caches live (default ./data/cache).
# CLIPDOCK_CACHE_DIR=./data/cache

# Optional: Markdown note repository and its rebuildable SQLite index.
# CLIPDOCK_LIBRARY_DIR=./data/library
# CLIPDOCK_LIBRARY_DB=./data/library.sqlite3
# LIBRARY_TRASH_TTL_DAYS=7

# AI summary (OpenAI-compatible endpoint). Leave the key empty to disable.
SUMMARY_API_BASE=https://api.deepseek.com/v1
SUMMARY_API_KEY=
SUMMARY_MODEL=deepseek-flash
SUMMARY_MAX_DURATION_SECONDS=2700
SUMMARY_MAX_CHARS=30000
# 并行任务：任务级、转写、LLM、文案分别限流。
SUMMARY_WORKERS=3
SUMMARY_TRANSCRIBE_WORKERS=1
SUMMARY_LLM_CONCURRENCY=4
SUMMARY_ARTICLE_WORKERS=2
SUMMARY_QUEUE_MAX=20
SUMMARY_JOB_TTL_SECONDS=86400
SUMMARY_MAX_JOBS=100
SUMMARY_LLM_RETRIES=2
SUMMARY_LLM_BACKOFF_SECONDS=1.5
SUMMARY_PERSIST_JOBS=true
# AI 整理稿（完整文案）
SUMMARY_ARTICLE_ENABLED=true
SUMMARY_ARTICLE_MAX_CHARS=24000
SUMMARY_CACHE_TTL_SECONDS=2592000
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Limits (bytes / seconds).
MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=4294967296
MIN_FREE_BYTES=536870912
JOB_TTL_SECONDS=1800
DOWNLOAD_WORKERS=2
# 0 = unlimited. On a small cloud instance set 1 so only one video downloads at a time.
DOWNLOAD_CONCURRENCY=0
