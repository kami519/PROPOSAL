# ClipDock 服务器配置（Ubuntu Server 24.04 / 2C2G 优化）
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要提交真实密钥。

# --- AI 总结（OpenAI 兼容接口）---
SUMMARY_API_BASE=https://api.deepseek.com/v1
SUMMARY_API_KEY=
SUMMARY_MODEL=deepseek-flash

# --- 并行任务：2 核 CPU 下建议 2 路任务、1 路 Whisper ---
SUMMARY_WORKERS=2
SUMMARY_TRANSCRIBE_WORKERS=1
SUMMARY_LLM_CONCURRENCY=4
SUMMARY_ARTICLE_WORKERS=1
SUMMARY_QUEUE_MAX=12
SUMMARY_JOB_TTL_SECONDS=86400
SUMMARY_MAX_JOBS=100
SUMMARY_LLM_RETRIES=2
SUMMARY_PERSIST_JOBS=true
SUMMARY_MAX_DURATION_SECONDS=2700
SUMMARY_MAX_CHARS=30000
SUMMARY_ARTICLE_ENABLED=true
SUMMARY_ARTICLE_MAX_CHARS=24000
SUMMARY_CACHE_TTL_SECONDS=2592000

# --- 本地 Whisper ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- 下载限制 ---
MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=2147483648
MIN_FREE_BYTES=536870912
JOB_TTL_SECONDS=1800
DOWNLOAD_WORKERS=1

# --- 访问限制 ---
# 填 0 表示不限制；填 1 表示同一时间只允许 1 个视频下载任务。
# 5Mbps 带宽下建议保持 1，避免多人并发把带宽和磁盘打满。
DOWNLOAD_CONCURRENCY=1

# --- 可选：需要登录/会员才能拿到高清的平台 ---
# YTDLP_COOKIES=/opt/clipdock/cookies.txt
# YTDLP_PROXY=http://127.0.0.1:7890
